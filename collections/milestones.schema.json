{
  "$ref": "#/definitions/milestones",
  "definitions": {
    "milestones": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "year": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "image": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "src": {
                    "type": "string"
                  },
                  "alt": {
                    "type": "string",
                    "minLength": 1,
                    "errorMessage": {
                      "minLength": "Alt text is required"
                    }
                  }
                },
                "required": [
                  "src",
                  "alt"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "video": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "src": {
                  "$ref": "#/definitions/milestones/additionalProperties/properties/image/anyOf/0/properties/src"
                },
                "alt": {
                  "$ref": "#/definitions/milestones/additionalProperties/properties/image/anyOf/0/properties/alt"
                },
                "caption": {
                  "type": "string"
                },
                "video": {
                  "type": "string"
                },
                "small": {
                  "type": "boolean"
                }
              },
              "required": [
                "src",
                "alt"
              ],
              "additionalProperties": false
            },
            "default": []
          },
          "tiktok": {
            "type": "string"
          },
          "creators": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "divisions": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "collection": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "collection"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "slug": {
                      "type": "string"
                    },
                    "collection": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "slug",
                    "collection"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "default": []
          },
          "behind": {
            "type": "object",
            "properties": {
              "division": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "collection": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "collection"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "slug": {
                        "type": "string"
                      },
                      "collection": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "slug",
                      "collection"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              }
            },
            "required": [
              "division",
              "count"
            ],
            "additionalProperties": false
          },
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "legacy",
              "unverified"
            ]
          },
          "source": {
            "type": "string"
          },
          "order": {
            "type": "number"
          }
        },
        "required": [
          "year",
          "title",
          "body",
          "status",
          "source",
          "order"
        ],
        "additionalProperties": false
      }
