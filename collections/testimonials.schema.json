{
  "$ref": "#/definitions/testimonials",
  "definitions": {
    "testimonials": {
      "type": "object",
      "properties": {
        "quote": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "brand",
            "creator",
            "student"
          ]
        },
        "division": {
          "type": "string",
          "enum": [
            "social",
            "talent",
            "education"
          ]
        },
        "image": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "src": {
                  "type": "string"
                },
                "alt": {
                  "type": "string",
                  "minLength": 1,
                  "errorMessage": {
                    "minLength": "Alt text is required"
                  }
                }
              },
              "required": [
                "src",
                "alt"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "consent": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "confirmed",
                "legacy",
                "listed",
                "none"
              ]
            },
            "confirmedBy": {
              "type": "string"
            },
            "date": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "integer",
                  "format": "unix-time"
                }
              ]
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false
        },
        "featured": {
          "type": "boolean",
          "default": false
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "quote",
        "name",
        "role",
        "type",
        "division",
        "image",
        "consent"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}