{
  "$ref": "#/definitions/pages",
  "definitions": {
    "pages": {
      "type": "object",
      "properties": {
        "sections": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "approved",
                  "draft"
                ]
              },
              "eyebrow": {
                "type": "string"
              },
              "headline": {
                "type": "string"
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "body": {
                "type": "string"
              },
              "cta": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "href": {
                    "type": "string"
                  }
                },
                "required": [
                  "label",
                  "href"
                ],
                "additionalProperties": false
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "copy": {
                      "type": "string"
                    },
                    "cta": {
                      "type": "string"
                    },
                    "href": {
                      "type": "string"
                    },
                    "audience": {
                      "type": "string"
                    },
                    "image": {
                      "type": "string"
                    },
                    "alt": {
                      "type": "string"
                    },
                    "position": {
                      "type": "string"
                    },
                    "channel": {
                      "type": "string"
                    },
                    "embed": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "label"
                  ],
                  "additionalProperties": false
                }
              },
              "awaiting": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "images": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "src": {
                      "$ref": "#/definitions/pages/properties/sections/additionalProperties/properties/items/items/properties/image"
                    },
                    "alt": {
                      "type": "string",
                      "minLength": 1,
                      "errorMessage": {
                        "minLength": "Alt text is required"
                      }
                    },
                    "caption": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "src",
                    "alt"
                  ],
                  "additionalProperties": false
                }
              },
              "counts": {
                "type": "boolean"
              },
              "featured": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "leaveOut": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "niches": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "creators": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "default": []
                    },
                    "clips": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "src": {
                            "type": "string"
                          },
                          "poster": {
                            "type": "string"
                          },
                          "alt": {
                            "type": "string"
                          },
                          "creator": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "src",
                          "poster",
                          "alt"
                        ],
                        "additionalProperties": false
                      },
                      "default": []
                    },
                    "rosterPost": {
                      "type": "boolean",
                      "default": false
                    }
                  },
                  "required": [
                    "key",
                    "label"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "status"
            ],
            "additionalProperties": false
          }
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "sections"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}