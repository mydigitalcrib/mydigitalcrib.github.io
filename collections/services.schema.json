{
  "$ref": "#/definitions/services",
  "definitions": {
    "services": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "number": {
          "type": "number"
        },
        "descriptor": {
          "type": "string"
        },
        "copyStatus": {
          "type": "string",
          "enum": [
            "approved",
            "draft",
            "needed"
          ],
          "default": "needed"
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "faqs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "q": {
                "type": "string"
              },
              "a": {
                "type": "string"
              }
            },
            "required": [
              "q",
              "a"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "hero": {
          "type": "object",
          "properties": {
            "src": {
              "type": "string"
            },
            "alt": {
              "type": "string",
              "minLength": 1,
              "errorMessage": {
                "minLength": "Alt text is required"
              }
            },
            "position": {
              "type": "string"
            }
          },
          "required": [
            "src",
            "alt"
          ],
          "additionalProperties": false
        },
        "gallery": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "src": {
                "$ref": "#/definitions/services/properties/hero/properties/src"
              },
              "alt": {
                "$ref": "#/definitions/services/properties/hero/properties/alt"
              },
              "position": {
                "type": "string"
              }
            },
            "required": [
              "src",
              "alt"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "seo": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "title",
            "description"
          ],
          "additionalProperties": false
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "number",
        "descriptor"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}